# Perry Business Directory static SPA. Container port 80; the host maps it
# (127.0.0.1:3002 in staging) and nginx fronts public traffic.
:80 {
    root * /srv
    encode gzip
    try_files {path} {path}/index.html /index.html
    header /index.html Cache-Control "no-cache, no-store, must-revalidate"
    file_server
}
